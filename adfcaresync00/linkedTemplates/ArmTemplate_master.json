{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfcaresync00"
		},
		"ls_adls_caresync00_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls_caresync00'"
		},
		"ls_adls_caresync00_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlscaresync00.dfs.core.windows.net/"
		},
		"ls_azure_sql_00_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sqlservercaresync00.database.windows.net"
		},
		"ls_azure_sql_00_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "db_caresync_00"
		},
		"ls_azure_sql_00_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "CareSync1234"
		},
		"ls_databricks_caresync_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1121-155827-kh5yki1o"
		},
		"ls_key_vault_caresync00_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://key-vault-caresync-00.vault.azure.net/"
		},
		"ls_postgres_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-wandering-fog-bd2kpuvv-pooler.c-8.us-east-2.aws.neon.tech"
		},
		"ls_postgres_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"ls_postgres_sql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfcaresync00_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_caresync00_accountKey": {
						"value": "[parameters('ls_adls_caresync00_accountKey')]"
					},
					"ls_adls_caresync00_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_caresync00_properties_typeProperties_url')]"
					},
					"ls_key_vault_caresync00_properties_typeProperties_baseUrl": {
						"value": "[parameters('ls_key_vault_caresync00_properties_typeProperties_baseUrl')]"
					},
					"ls_azure_sql_00_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_sql_00_properties_typeProperties_server')]"
					},
					"ls_azure_sql_00_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_sql_00_properties_typeProperties_database')]"
					},
					"ls_azure_sql_00_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_sql_00_properties_typeProperties_userName')]"
					},
					"ls_databricks_caresync_properties_typeProperties_existingClusterId": {
						"value": "[parameters('ls_databricks_caresync_properties_typeProperties_existingClusterId')]"
					},
					"ls_postgres_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_postgres_sql_properties_typeProperties_server')]"
					},
					"ls_postgres_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_postgres_sql_properties_typeProperties_database')]"
					},
					"ls_postgres_sql_properties_typeProperties_username": {
						"value": "[parameters('ls_postgres_sql_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}